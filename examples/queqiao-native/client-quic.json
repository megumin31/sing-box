{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "local-socks",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "queqiao",
      "tag": "gateway",
      "profile_path": "./client-profile.json",
      "transport": "quic",
      "tcp_recovery": true,
      "udp_resume": true,
      "quic_active_fallback": true
    }
  ],
  "route": {
    "final": "gateway"
  }
}
